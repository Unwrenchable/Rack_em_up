# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rackup
# or DATABASE_URL=postgres://postgres:postgres@localhost:5432/rackup

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production

# CORS (include your Vite origin)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# RealAI — intelligence provider (REALAI_RACKUP_WIRING_CONTRACT.md)
# Canonical: POST {REALAI_BASE_URL}/v1/plugins/rackup-coach
#
# Local Hive / Vulkan GPU (operator PC): http://127.0.0.1:8001
#   Hive/orch is 8001, not 8000. Do not point this at realaiui.vercel.app.
#   Hive plugin route is an expected 404. Documented LIVE path:
#   POST /v1/tools/execute { name: "rackup_invoke", arguments: <same
#   ability/player/payload envelope> } (video_analysis / coach).
#   Render api_server stays plugin-first (no tools fallback).
#   Override with REALAI_HIVE_TOOLS_FALLBACK=1|0.
# Render https://realai-api.onrender.com is API-only — no GGUF / default_llm.
#   Coach text needs OPENAI_API_KEY or REALAI_OPENAI_API_KEY on the **realai-api**
#   service (not only on Nest). Nest still calls rackup-coach; chat/completions
#   on Render returns a placeholder and is treated as failure.
# REALAI_BASE_URL=https://realai-api.onrender.com
REALAI_BASE_URL=http://127.0.0.1:8001
REALAI_MODEL=realai-2.0
# REALAI_API_KEY=
# Optional Nest-side cloud LLM key forward (prefer setting the key on realai-api)
# REALAI_OPENAI_API_KEY=
# REALAI_COACH_PATH=/v1/plugins/rackup-coach
# Alias (auto-tried on 404): /v1/rackup/coach
# REALAI_TIMEOUT_MS=20000
# REALAI_HIVE_TOOLS_FALLBACK=1
# Opt in to /v1/chat/completions harvest (Hive GPU only; skip on Render)
# REALAI_CHAT_FALLBACK=1
# RACKUP_TENANT=dev
# When RealAI is down, allow Nest local rating nudge (dev only — NOT Glicko-2).
# Production: leave unset so rating_update failures do not write fake Glicko state.
REALAI_FALLBACK_LOCAL_ELO=1

# Session lifetime (access JWT + refresh cookie/token)
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=30d

# --- ROC payments (USD ledger; Stripe cards + Apple/Google Pay + USDC) ---
# Leave STRIPE_SECRET_KEY unset for mock checkout + mock-confirm path.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ROC_STRIPE_SUCCESS_URL=http://localhost:5173/wallet?roc_pay=success
# ROC_STRIPE_CANCEL_URL=http://localhost:5173/wallet?roc_pay=cancel
# ROC_USDC_ENABLED=true
# ROC_USDC_NETWORK=solana

# TypeORM — prefer true for local demo; false + migrations in prod
TYPEORM_SYNC=true

# Escrow (Phase 3D) — mock by default
ESCROW_PROVIDER=mock
# ESCROW_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...

# Object storage (P3) — local by default
STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# Push (P3) — without FCM key, notifies in-app + Redis queue
# FCM_SERVER_KEY=
# PUSH_ENABLED=true

# --- Unified Player Card / FargoRate read (no LMS, no match POST) ---
# FargoRate public dashboard (read-only). Timeout + in-memory cache.
# FARGO_API_BASE=https://dashboard.fargorate.com/api
# FARGO_TIMEOUT_MS=8000
# FARGO_CACHE_TTL_MS=600000
#
# APA lookup stub — skipped unless both are set. Never invents SL; never POSTs matches.
# APA_API_TOKEN=
# APA_API_BASE=
# APA_TIMEOUT_MS=8000
#
# TAP/BCA scrape stays OFF. Manual import: POST /api/v1/ratings/import/manual
# TAP_SCRAPE_ENABLED=0
# BCA_SCRAPE_ENABLED=0
#
# Do NOT set a flag that writes leagues-v2 0–3000 unified ratings onto users.rating.
# ROC Glicko-2 is canonical (500 / RD 175 / σ 0.06) via RatingService only.

# --- Frontend (set in rackup-web/.env, not required for backend) ---
# Local recommended: leave VITE_API_URL unset so Vite proxies /api and /socket.io
# VITE_API_URL=http://localhost:3000/api/v1
# VITE_WS_URL=http://localhost:3000
