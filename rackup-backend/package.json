{
  "name": "rackup-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "npx nest build",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:smoke": "jest --config jest.smoke.config.js --runInBand",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "seed:demo": "ts-node -r dotenv/config scripts/seed-demo.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/ormconfig.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/ormconfig.ts"
  },
  "dependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/common": "^10.4.2",
    "@nestjs/core": "^10.4.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/platform-socket.io": "^10.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.2",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "4.22.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.3",
    "typeorm": "^0.3.20",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.5",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "overrides": {
    "express": "4.22.2"
  },
  "engines": {
    "node": ">=20"
  }
}
